# Local Windows launcher configuration. Copy this file to .env and edit values.
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PAPER2PRODUCT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional paper-understanding provider. Leave blank for the labeled rule-based fallback.
PAPER2PRODUCT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
